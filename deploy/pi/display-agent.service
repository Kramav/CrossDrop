# Room display agent. Install to ~/.config/systemd/user/display-agent.service
# See deploy/pi/README.md.
#
# A *user* unit, not a system one: the agent launches the kiosk browser itself
# (agent/app.py lifespan), so it has to live inside the logged-in graphical
# session. A detached system daemon has no display to draw on. PLAN.md §6.

[Unit]
Description=Room display agent (FastAPI + kiosk browser)
# Ordering only, no Requires: on Pi OS graphical-session.target is not always
# reached by the compositor, and a hard dependency would wedge us if it isn't.
After=graphical-session.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/room-display/current
Environment=ROOM_CONFIG=/etc/room-display/config.toml
# Written by update.sh into each release dir as `ROOM_VERSION=<tag>`, so
# /v1/status reports the tag it is actually running. The `-` keeps a plain
# Phase 5 checkout (no VERSION file) working -- it just reports "dev".
EnvironmentFile=-/opt/room-display/current/VERSION

# Phase 6: the profile lives on tmpfs, so it starts empty every boot. Restore it
# before the agent launches the browser, save it after the browser is gone.
# The leading `-` means a failed restore still lets the kiosk come up -- the
# script handles a corrupt archive itself, this is the second layer of the same
# rule: never let snapshot trouble brick a Pi with no keyboard.
ExecStartPre=-/opt/room-display/current/deploy/pi/profile-snapshot.sh restore
# Runs after the main process exits, including on restart. The script's own
# 5-minute floor is what stops a crash loop turning this into constant SD writes.
ExecStopPost=-/opt/room-display/current/deploy/pi/profile-snapshot.sh save
# Both, deliberately. Pi OS defaults to labwc (Wayland), but its Chromium may
# use either the native Wayland backend or the X11 one under XWayland, and the
# wrong variable alone means the kiosk never appears. Setting both costs
# nothing; the unused one is ignored. Confirm the real values against the
# session — see "Check what the session actually exports" in pi-setup.md.
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0

# --host binds the tailnet interface only, never 0.0.0.0 (PLAN.md §10). Asking
# tailscaled beats hardcoding the IP, which changes if the node is re-authed.
# If `tailscale ip` is not permitted for your user, substitute the literal IP.
#
# Anywhere that is not the Pi, `.venv/bin/python -m agent serve` reads host and
# port from [server] in config.toml instead — that is the way to start an agent
# without systemd. The Pi keeps the line below because a re-auth changes the IP
# and asking tailscaled at boot beats rewriting a config file.
ExecStart=/bin/sh -c 'exec .venv/bin/uvicorn agent.app:app --host "$(tailscale ip -4)" --port 8080'

# The compositor and tailscaled may not be up when we are. Rather than race them
# with a polling ExecStartPre, fail fast and let systemd retry until they are.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
