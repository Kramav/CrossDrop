{
  "manifest_version": 3,
  "name": "CrossDrop",
  "description": "Send this tab to a CrossDrop display on your tailnet.",
  "version": "0.1.0",
  "action": {
    "default_title": "CrossDrop",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "alarms", "contextMenus", "storage"],
  "optional_permissions": ["tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "send-tab": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Send this tab to the display"
    }
  }
}
